# 複製到主機 /opt/<專案>/.env.prod 後填值；這個檔案不要放真實密碼
ENVIRONMENT=production
POSTGRES_USER=anxin
POSTGRES_PASSWORD=請改成隨機長密碼
POSTGRES_DB=anxin
DATABASE_URL=postgresql+asyncpg://anxin:請改成隨機長密碼@postgres:5432/anxin
REDIS_URL=redis://redis:6379/0
# 至少 32 字元：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=["https://your-domain.example"]

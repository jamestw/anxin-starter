{
  "name": "anxin-starter-driver",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:preview": "npx --yes eas-cli build --platform all --profile preview",
    "release:android": "npx --yes eas-cli build --platform android --profile production --auto-submit",
    "release:ios": "npx --yes eas-cli build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.23",
    "expo-location": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
